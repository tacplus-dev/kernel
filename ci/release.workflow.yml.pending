name: release

# On a version tag vX.Y.Z: run the gates on the tag, publish ghcr.io/tacplus-dev/kernel:X.Y.Z for PLATFORMS,
# move the line tag X.Y when this is the line's highest release (ci/release-tags.sh), and create the GitHub
# release with the commits since the previous release (ci/release-notes.sh), Latest only when it is the highest
# release (ci/release-latest.sh). A pre-release (vX.Y.Z-rc.N) publishes only its own tag. Fleets pin X.Y
# (tacplus-dev/tacplus#180). Modelled on tacplus-dev/llmproxy's release.yml; how to cut a release: README.md.
#
# workflow_dispatch releases a tag that already exists (publish: true), from this workflow's scripts, for a tag
# on a commit without them (v0.1.0): the same gates, image and release as a tag push. With publish false (the
# default) it is a dry run of the version given: an existing tag, or HEAD standing for a new one; it runs the
# gates, builds the image and prints the image tags and the notes that release would get, and publishes nothing.

on:
  push:
    tags: ["v*.*.*"]
  workflow_dispatch:
    inputs:
      tag:
        description: "Version, e.g. v0.1.0 (an existing tag to publish), or v0.1.1 (a dry run of HEAD)"
        required: true
      publish:
        description: "Publish the existing tag (image and GitHub release); off: a dry run, nothing published"
        type: boolean
        default: false

permissions:
  contents: read

# One release at a time, so of two tags on one line the later run sees the other before it moves X.Y.
concurrency:
  group: release
  cancel-in-progress: false

env:
  IMAGE: ghcr.io/${{ github.repository }}
  VERSION: ${{ inputs.tag || github.ref_name }}
  DRY_RUN: ${{ github.event_name == 'workflow_dispatch' && !inputs.publish }}
  # The platforms the image is built for, as the fleets' images/pins.yaml `platforms`: arm64, what the fleets
  # run on; amd64 is off to save a second build (Jody, 2026-11-07). "amd64 arm64" builds both, one image.
  PLATFORMS: arm64
  # The launcher the image runs under (Dockerfile), built from source at this commit (llmproxy's pin).
  LAUNCHER_COMMIT: d130eab7fcb42413fe0d2bdf5543e4edc23f9747

jobs:
  gates:
    runs-on: ubuntu-24.04
    outputs:
      revision: ${{ steps.revision.outputs.revision }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - name: The release scripts' tests
        run: ci/release_test.sh
      - name: The commit to release
        id: revision
        run: |
          set -euo pipefail
          ci/release-tags.sh "$VERSION" >/dev/null
          git fetch --force --tags origin
          if git rev-parse -q --verify "refs/tags/$VERSION" >/dev/null; then
            revision="$(git rev-parse "$VERSION^{commit}")"
          elif [[ $DRY_RUN == true ]]; then
            revision="$(git rev-parse HEAD)"
            echo "$VERSION is not tagged: HEAD stands for it"
          else
            echo "no tag $VERSION: tag it first"; exit 1
          fi
          echo "$VERSION: $revision"
          echo "revision=$revision" >> "$GITHUB_OUTPUT"
          # The released commit, alone: its own justfile and tacplus.lock run its gates.
          git clone -q "$GITHUB_WORKSPACE" "$RUNNER_TEMP/src"
          git -C "$RUNNER_TEMP/src" checkout -q --detach "$revision"
      - name: Gates, in the build image the release pins
        env:
          # Read-only (this job's permissions): tacplus reads its releases through the GitHub API.
          GH_TOKEN: ${{ github.token }}
        run: ci/release-gates.sh "$RUNNER_TEMP/src" "$RUNNER_TEMP/home"
      - uses: actions/upload-artifact@v4
        with:
          name: kernel-jar
          path: ${{ runner.temp }}/src/server/target/kernel.jar
          if-no-files-found: error
          retention-days: 7

  release:
    needs: gates
    runs-on: ubuntu-24.04
    permissions:
      contents: write
      packages: write
    env:
      REVISION: ${{ needs.gates.outputs.revision }}
    steps:
      - uses: actions/checkout@v4
        with:
          # Every tag: the line tag and the notes depend on the releases already made.
          fetch-depth: 0
      - name: Tags and notes
        id: plan
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          git fetch --force --tags origin
          if ! git rev-parse -q --verify "refs/tags/$VERSION" >/dev/null; then
            [[ $DRY_RUN == true ]] || { echo "no tag $VERSION"; exit 1; }
            git tag "$VERSION" "$REVISION"
          fi
          [[ "$(git rev-parse "$VERSION^{commit}")" == "$REVISION" ]] || { echo "$VERSION moved since its gates ran"; exit 1; }
          if [[ $DRY_RUN != true ]] && gh release view "$VERSION" >/dev/null 2>&1; then
            echo "$VERSION is already released"; exit 1
          fi
          tags="$(ci/release-tags.sh "$VERSION")"
          flag="$(ci/release-latest.sh "$VERSION")"
          ci/release-notes.sh "$VERSION" > "$RUNNER_TEMP/notes.md"
          { echo "tags=$tags"; echo "flag=$flag"; } >> "$GITHUB_OUTPUT"
          echo "dry run: $DRY_RUN"
          echo "revision: $REVISION"
          echo "platforms: $PLATFORMS"
          echo "image tags: $(for t in $tags; do printf '%s:%s ' "$IMAGE" "$t"; done)"
          echo "release: $flag"
          cat "$RUNNER_TEMP/notes.md"
      - uses: actions/download-artifact@v4
        with:
          name: kernel-jar
          path: ${{ runner.temp }}/jar
      - uses: actions/checkout@v4
        with:
          repository: tacplus-dev/launcher
          ref: ${{ env.LAUNCHER_COMMIT }}
          path: target/launcher-src
      - uses: actions/setup-go@v5
        with:
          go-version-file: target/launcher-src/go.mod
          cache: false
      - name: launcher
        working-directory: target/launcher-src
        run: |
          for arch in $PLATFORMS; do
            CGO_ENABLED=0 GOOS=linux GOARCH=$arch go build -trimpath -ldflags="-s -w" -o "../launcher/launcher-linux-$arch" .
          done
      # The Dockerfile's RUN step runs on each target platform.
      - uses: docker/setup-qemu-action@v3
      - uses: docker/setup-buildx-action@v3
      - uses: docker/login-action@v3
        if: env.DRY_RUN != 'true'
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Image
        run: |
          tags=""
          [[ $DRY_RUN == true ]] || tags="${{ steps.plan.outputs.tags }}"
          # shellcheck disable=SC2086 # the tags are words
          ci/release-image.sh "${VERSION#v}" "$REVISION" "$RUNNER_TEMP/jar/kernel.jar" target/launcher $tags
          [[ $DRY_RUN == true ]] || docker buildx imagetools inspect "$IMAGE:${VERSION#v}"
      - name: GitHub release
        if: env.DRY_RUN != 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release create "$VERSION" --verify-tag --title "$VERSION" --notes-file "$RUNNER_TEMP/notes.md" ${{ steps.plan.outputs.flag }}
