package {{PACKAGE}};

import {{SPIFFE_PACKAGE}}.Spiffe;

/**
 * NamespaceScope chroots kernel state keys to the calling service's namespace.
 *
 * <p>Kernel state is a flat {@code Map<String, Proto>} per boundary, shared by
 * every caller, with no tenant anywhere in the key or the map name. Isolation is
 * therefore a KEY-PREFIX REWRITE: a caller whose namespace is a tenant root
 * ({@code /tenants/<tenant>}) has every key it names prefixed on ingress and the
 * prefix stripped on egress, and never sees an entry outside its own prefix.
 *
 * <p>A {@code /system} caller — every shared platform service — has an empty
 * prefix, so {@link #scope}, {@link #unscope} and {@link #owns} are the identity
 * and old behaviour is unchanged by construction, not by argument.
 *
 * <p>The classification is <b>confined by default</b>: only {@code /} and
 * {@code /system[/…]} are unconfined. Every other namespace — a tenant root, and
 * any root segment added later — chroots, so a namespace this class has never
 * heard of can never be handed the identity rewrite by omission.
 *
 * <p><b>Only the map key is rewritten.</b> Payloads are never touched. A record
 * that also carries its key as a field ({@code (spec.indexed)} keys,
 * {@code instance_keyed} composite ids) must come back exactly as the caller
 * wrote it, and because the key the caller reads back is the stripped one, the
 * field and the key still agree.
 *
 * <p>Generated by tacplus
 */
public final class NamespaceScope {

    /** The one namespace root that is unconfined, and the parent of every location under it. */
    private static final String SYSTEM_NAMESPACE = "/" + Spiffe.SYSTEM_SEGMENT;

    /** The unscoped scope: what every {@code /system} caller gets. */
    private static final NamespaceScope ROOT = new NamespaceScope("");

    /**
     * The scope of an authenticated caller whose token carries no namespace at
     * all: it owns nothing and can name nothing. Reachable for any token class
     * that is neither a service/workload (namespace from the subject) nor a user
     * (namespace from the claim) — a {@code pipeline} token, say — which
     * {@code checkAccess} denies on every policed graph, the generated store
     * servers now included: they carry their computed policy graph key, and a
     * caller with no service identity fails that check outright. The view
     * servers are the last callers passing {@code NO_POLICY_GRAPH}, so this
     * scope is what holds there. It must not be ROOT, and it cannot be a prefix
     * either: the empty namespace's prefix would be "/", which is a prefix of
     * every tenant's storage key.
     */
    private static final NamespaceScope NONE = new NamespaceScope(null);

    /**
     * "" for a root caller, "&lt;namespace&gt;/" for a confined one — e.g.
     * "/tenants/acme/" — and null for a caller with no namespace at all.
     */
    private final String prefix;

    private NamespaceScope(String prefix) {
        this.prefix = prefix;
    }

    /** The unscoped scope — the identity rewrite. */
    public static NamespaceScope root() {
        return ROOT;
    }

    /**
     * The current gRPC call's scope, read from
     * {@link SecurityAuthenticator#CALLER_NAMESPACE_KEY}. The root scope is
     * {@code /} and {@code /system}, including a location-bearing
     * {@code /system/<location>}; every other namespace is confined under itself;
     * an authenticated caller with an empty namespace owns nothing.
     *
     * <p>An <i>absent</i> key — as opposed to an empty one — is not a caller at
     * all: the caller interceptor always installs this key, so it is unset only
     * off a gRPC call, on kernel's own machinery, which is unconfined.
     */
    public static NamespaceScope current() {
        String namespace = SecurityAuthenticator.CALLER_NAMESPACE_KEY.get();
        if (namespace == null) {
            return ROOT;
        }
        if (namespace.isEmpty()) {
            return NONE;
        }
        if (namespace.equals("/") || namespace.equals(SYSTEM_NAMESPACE)
                || namespace.startsWith(SYSTEM_NAMESPACE + "/")) {
            return ROOT;
        }
        return new NamespaceScope(namespace + "/");
    }

    /** Whether this scope rewrites nothing. */
    public boolean isRoot() {
        return prefix != null && prefix.isEmpty();
    }

    /** Ingress: the stored key for a key the caller named. */
    public String scope(String key) {
        requireNamespace();
        return prefix.isEmpty() ? key : prefix + key;
    }

    /** Whether a stored key belongs to this scope. */
    public boolean owns(String storedKey) {
        return prefix != null && (prefix.isEmpty() || storedKey.startsWith(prefix));
    }

    /** Egress: the caller-visible key for a stored key this scope {@link #owns}. */
    public String unscope(String storedKey) {
        requireNamespace();
        return prefix.isEmpty() ? storedKey : storedKey.substring(prefix.length());
    }

    private void requireNamespace() {
        if (prefix == null) {
            throw new IllegalStateException("caller token carries no namespace: no key is in scope");
        }
    }

    /** Scopes are compared by prefix so watchers can be grouped by the snapshot they see. */
    @Override
    public boolean equals(Object o) {
        return o instanceof NamespaceScope
                && java.util.Objects.equals(prefix, ((NamespaceScope) o).prefix);
    }

    @Override
    public int hashCode() {
        return java.util.Objects.hashCode(prefix);
    }

    @Override
    public String toString() {
        return "NamespaceScope[" + prefix + "]";
    }
}
