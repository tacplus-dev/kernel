package {{PACKAGE}};

import {{SPIFFE_PACKAGE}}.Spiffe;

/**
 * NamespaceScope chroots kernel state keys to the calling service's namespace.
 *
 * <p>Kernel state is a flat {@code Map<String, Proto>} per boundary, shared by
 * every caller, with no tenant anywhere in the key or the map name. Isolation is
 * therefore a KEY-PREFIX REWRITE: a caller whose namespace is a tenant root
 * ({@code /tenants/<tenant>}) has every key it names prefixed on ingress and the
 * prefix stripped on egress, and never sees an entry outside its own prefix.
 *
 * <p>A {@code /system} caller — every shared platform service — has an empty
 * prefix, so {@link #scope}, {@link #unscope} and {@link #owns} are the identity
 * and old behaviour is unchanged by construction, not by argument.
 *
 * <p><b>Only the map key is rewritten.</b> Payloads are never touched. A record
 * that also carries its key as a field ({@code (spec.indexed)} keys,
 * {@code instance_keyed} composite ids) must come back exactly as the caller
 * wrote it, and because the key the caller reads back is the stripped one, the
 * field and the key still agree.
 *
 * <p>Generated by tacplus
 */
public final class NamespaceScope {

    /** Namespace prefix that marks a tenant-owned caller. */
    private static final String TENANTS_PREFIX = "/" + Spiffe.TENANTS_SEGMENT + "/";

    /** The unscoped scope: what every {@code /system} caller gets. */
    private static final NamespaceScope ROOT = new NamespaceScope("");

    /** "" for a root caller, otherwise "&lt;namespace&gt;/" — e.g. "/tenants/acme/". */
    private final String prefix;

    private NamespaceScope(String prefix) {
        this.prefix = prefix;
    }

    /** The unscoped scope — the identity rewrite. */
    public static NamespaceScope root() {
        return ROOT;
    }

    /**
     * The current gRPC call's scope, read from
     * {@link SecurityAuthenticator#CALLER_NAMESPACE_KEY}. Anything that is not a
     * tenant namespace is the root scope: {@code /system}, a location-bearing
     * {@code /system/<location>}, and a caller with no namespace at all.
     */
    public static NamespaceScope current() {
        String namespace = SecurityAuthenticator.CALLER_NAMESPACE_KEY.get();
        if (namespace == null || !namespace.startsWith(TENANTS_PREFIX)) {
            return ROOT;
        }
        return new NamespaceScope(namespace + "/");
    }

    /** Whether this scope rewrites nothing. */
    public boolean isRoot() {
        return prefix.isEmpty();
    }

    /** Ingress: the stored key for a key the caller named. */
    public String scope(String key) {
        return prefix.isEmpty() ? key : prefix + key;
    }

    /** Whether a stored key belongs to this scope. */
    public boolean owns(String storedKey) {
        return prefix.isEmpty() || storedKey.startsWith(prefix);
    }

    /** Egress: the caller-visible key for a stored key this scope {@link #owns}. */
    public String unscope(String storedKey) {
        return prefix.isEmpty() ? storedKey : storedKey.substring(prefix.length());
    }

    /** Scopes are compared by prefix so watchers can be grouped by the snapshot they see. */
    @Override
    public boolean equals(Object o) {
        return o instanceof NamespaceScope && prefix.equals(((NamespaceScope) o).prefix);
    }

    @Override
    public int hashCode() {
        return prefix.hashCode();
    }

    @Override
    public String toString() {
        return "NamespaceScope[" + prefix + "]";
    }
}
