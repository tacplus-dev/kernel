package {{PACKAGE}};

import {{ERRORS_PACKAGE}}.ProtoException;
import {{TOKEN_PACKAGE}}.TokenWrapper;
import {{JWK_LIB_PACKAGE}}.ImmutableJwk;
import {{JWK_TYPES_PACKAGE}}.JwkOuterClass;
import io.grpc.Context;
import io.grpc.Metadata;
import java.util.LinkedHashMap;
import java.util.Map;
import java.util.concurrent.Semaphore;
import java.util.function.Supplier;
import java.util.regex.Pattern;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * SecurityAuthenticator provides caller identity extraction for generated
 * BackendServiceServer classes.
 *
 * <p>Authorization is enforced at the gRPC server level by SecurityInterceptor
 * using BackendSecurity policies from backenddb.proto. This class provides
 * the caller-extraction interceptor and a no-op checkAccess for the generated
 * per-service servers.
 *
 * <p>The {@link #callerInterceptor()} method returns a gRPC interceptor
 * that validates a JWT bearer token from the {@code authorization} metadata
 * header, extracts the {@code service_name} claim as the caller identity,
 * and stores it in a gRPC {@link Context.Key}.
 *
 * <p>Validated tokens are cached (keyed by raw JWT string) for their lifetime.
 * On cache miss with unknown {@code kid}, keys are refreshed from the provider.
 *
 * <p>Generated by tacplus
 */
public class SecurityAuthenticator {

    private static final Logger logger = LoggerFactory.getLogger(SecurityAuthenticator.class);

    // --- Unknown-kid retry / DoS-hardening knobs (configurable via system properties) ---
    // The retry loop sleeps a gRPC handler thread waiting for a just-published JWK to
    // propagate into shared kernel state. Each of these guards a distinct DoS vector:
    //   * the timeout bounds how long a single thread is parked,
    //   * the semaphore bounds how many threads may be parked at once (pool exhaustion),
    //   * the kid format gate + negative cache short-circuit bogus kids before any sleep.
    private static final long UNKNOWN_KID_RETRY_TIMEOUT_MILLIS =
            Long.getLong("tacplus.auth.unknownKidRetryTimeoutMillis", 750L);
    private static final long UNKNOWN_KID_INITIAL_BACKOFF_MILLIS =
            Long.getLong("tacplus.auth.unknownKidInitialBackoffMillis", 25L);
    private static final long UNKNOWN_KID_MAX_BACKOFF_MILLIS =
            Long.getLong("tacplus.auth.unknownKidMaxBackoffMillis", 250L);

    /** Max number of handler threads that may concurrently sit in the unknown-kid retry loop. */
    private static final int UNKNOWN_KID_MAX_CONCURRENT_RETRIERS =
            Integer.getInteger("tacplus.auth.unknownKidMaxConcurrentRetriers", 8);

    /** Bounded positive token cache. */
    private static final int TOKEN_CACHE_MAX_ENTRIES =
            Integer.getInteger("tacplus.auth.tokenCacheMaxEntries", 10_000);

    /** Bounded negative cache for recently-missed kids. */
    private static final int NEGATIVE_KID_CACHE_MAX_ENTRIES =
            Integer.getInteger("tacplus.auth.negativeKidCacheMaxEntries", 1_024);
    private static final long NEGATIVE_KID_CACHE_TTL_MILLIS =
            Long.getLong("tacplus.auth.negativeKidCacheTtlMillis", 1_000L);

    /**
     * Plausible-kid gate. Production kids are base64url(24 bytes) = 32 chars of
     * {@code [A-Za-z0-9_-]} (see generateRandomID). We accept the permissive-but-safe
     * superset of base64url strings up to 128 chars so legacy / longer kids are not
     * rejected, while still cheaply rejecting obvious junk (control chars, oversized
     * blobs) before any retry budget is spent. Configurable via system property.
     */
    private static final int KID_MAX_LENGTH =
            Integer.getInteger("tacplus.auth.kidMaxLength", 128);
    private static final Pattern KID_FORMAT = Pattern.compile("^[A-Za-z0-9_-]{1,512}$");

    /** Context key populated by the caller interceptor. */
    public static final Context.Key<String> CALLER_SERVICE_KEY = Context.key("caller-service");

    /** Context key for the authenticated caller's instance ID (instance_id claim). */
    public static final Context.Key<String> CALLER_INSTANCE_ID_KEY = Context.key("caller-instance-id");

    /** Metadata key for the authorization header (bearer token). */
    public static final Metadata.Key<String> AUTH_METADATA_KEY =
        Metadata.Key.of("authorization", Metadata.ASCII_STRING_MARSHALLER);

    /** The type of operation being performed. */
    public enum OperationType { READ, WRITE, ADMIN }

    /** Provider of JWK keys for token validation. Set after construction. */
    private volatile Supplier<JwkOuterClass.Jwks> keyProvider;

    /**
     * Bounded cache of validated tokens: raw JWT string → cached caller info.
     * Access-order LRU with a hard size cap; entries also carry a per-entry expiry
     * and are proactively evicted, so a flood of distinct (valid) tokens cannot grow
     * the map without bound. Guarded by its own monitor.
     */
    private final BoundedTtlCache<String, CachedCaller> tokenCache =
            new BoundedTtlCache<>(TOKEN_CACHE_MAX_ENTRIES);

    /**
     * Bounded negative cache of recently-missed kids. A bogus kid is recorded here so
     * repeated probes short-circuit instantly instead of each spending the retry budget.
     */
    private final BoundedTtlCache<String, Boolean> negativeKidCache =
            new BoundedTtlCache<>(NEGATIVE_KID_CACHE_MAX_ENTRIES);

    /** Bounds the number of handler threads concurrently parked in the unknown-kid retry loop. */
    private final Semaphore retrySlots = new Semaphore(Math.max(1, UNKNOWN_KID_MAX_CONCURRENT_RETRIERS));

    public SecurityAuthenticator() {
    }

    /**
     * Sets the key provider used to fetch JWK keys for token validation.
     * Must be called after construction, before any gRPC calls are processed.
     *
     * @param keyProvider supplies the current JWK key set
     */
    public void setKeyProvider(Supplier<JwkOuterClass.Jwks> keyProvider) {
        this.keyProvider = keyProvider;
    }

    /**
     * No-op — authorization is enforced at the gRPC server level by
     * SecurityInterceptor using BackendSecurity policies.
     *
     * @param targetService fully qualified backend service name
     * @param boundary      boundary field name (e.g., "roster")
     * @param op            the operation type (READ, WRITE, ADMIN)
     */
    public void checkAccess(String targetService, String boundary, OperationType op) throws ProtoException {
        // Authorization enforced by SecurityInterceptor at the gRPC level.
    }

    /**
     * Returns a gRPC ServerInterceptor that validates the JWT bearer token
     * from the {@code authorization} metadata header, extracts the
     * {@code service_name} claim as the caller identity, and stores it in
     * the gRPC Context for use by downstream handlers.
     *
     * <p>Validated tokens are cached for their lifetime. On cache miss with
     * an unknown {@code kid}, keys are refreshed from the provider before
     * rejecting.
     */
    public io.grpc.ServerInterceptor callerInterceptor() {
        return new io.grpc.ServerInterceptor() {
            @Override
            public <ReqT, RespT> io.grpc.ServerCall.Listener<ReqT> interceptCall(
                    io.grpc.ServerCall<ReqT, RespT> call,
                    io.grpc.Metadata headers,
                    io.grpc.ServerCallHandler<ReqT, RespT> next) {
                String method = call.getMethodDescriptor().getFullMethodName();
                // Health check service is unauthenticated.
                if (method.startsWith("grpc.health.v1.Health/")) {
                    return next.startCall(call, headers);
                }
                // Services with disable_auth_service = true handle their own auth.
                // Skip the caller interceptor for them.
                if ({{NO_AUTH_SKIP}}) {
                    return next.startCall(call, headers);
                }
                String authHeader = headers.get(AUTH_METADATA_KEY);
                if (authHeader == null) {
                    logger.warn("[auth] REJECTED {} — missing authorization header", method);
                    call.close(io.grpc.Status.UNAUTHENTICATED.withDescription("missing authorization header"), new io.grpc.Metadata());
                    return new io.grpc.ServerCall.Listener<>() {};
                }
                if (!authHeader.startsWith("Bearer ")) {
                    logger.warn("[auth] REJECTED {} — authorization header is not a Bearer token", method);
                    call.close(io.grpc.Status.UNAUTHENTICATED.withDescription("authorization header must be Bearer token"), new io.grpc.Metadata());
                    return new io.grpc.ServerCall.Listener<>() {};
                }
                String rawToken = authHeader.substring(7);
                CachedCaller caller;
                try {
                    caller = resolveCallerFromToken(rawToken);
                    logger.info("[auth] ACCEPTED {} — caller={}", method, caller.serviceName);
                } catch (Exception e) {
                    logger.warn("[auth] REJECTED {} — token validation failed: {}", method, e.getMessage(), e);
                    call.close(io.grpc.Status.UNAUTHENTICATED.withDescription("token authentication failed: " + e.getMessage()), new io.grpc.Metadata());
                    return new io.grpc.ServerCall.Listener<>() {};
                }
                io.grpc.Context ctx = io.grpc.Context.current()
                    .withValue(CALLER_SERVICE_KEY, caller.serviceName);
                if (caller.instanceId != null && !caller.instanceId.isEmpty()) {
                    ctx = ctx.withValue(CALLER_INSTANCE_ID_KEY, caller.instanceId);
                }
                return io.grpc.Contexts.interceptCall(ctx, call, headers, next);
            }
        };
    }

    /**
     * Resolves the caller identity from a raw JWT token string.
     * Uses the token cache for validated tokens. On cache miss, validates
     * the token against the key provider's JWK keys.
     */
    private CachedCaller resolveCallerFromToken(String rawToken) throws ProtoException {
        // Check cache first
        CachedCaller cached = tokenCache.get(rawToken);
        if (cached != null) {
            return cached;
        }

        // Cache miss — validate the token
        Supplier<JwkOuterClass.Jwks> provider = this.keyProvider;
        if (provider == null) {
            throw new ProtoException(ProtoException.UNAUTHENTICATED, "no key provider configured");
        }

        TokenWrapper tw = TokenWrapper.parse(rawToken);
        String kid = tw.getKid();
        if (kid == null || kid.isEmpty()) {
            throw new ProtoException(ProtoException.UNAUTHENTICATED, "token missing kid header");
        }

        // H2 gate (a): reject implausible kids before spending any retry budget.
        if (kid.length() > KID_MAX_LENGTH || !KID_FORMAT.matcher(kid).matches()) {
            throw new ProtoException(ProtoException.UNAUTHENTICATED, "malformed kid");
        }

        JwkOuterClass.Jwk matchingKey = waitForKeyByKid(provider, kid);
        if (matchingKey == null) {
            throw new ProtoException(ProtoException.UNAUTHENTICATED, "unknown kid: " + kid);
        }

        ImmutableJwk immJwk = ImmutableJwk.from(matchingKey);
        tw.verify(immJwk);

        // Reject refresh tokens — they should only be exchanged at the Mint endpoint.
        String tokenUse = tw.getTokenUse();
        if ("refresh".equals(tokenUse)) {
            throw new ProtoException(ProtoException.UNAUTHENTICATED, "refresh tokens cannot be used for API access");
        }
        if (tokenUse.isEmpty()) {
            // Legacy fallback: check typ claim
            String typ = tw.getCustomField("typ");
            if ("refresh".equals(typ)) {
                throw new ProtoException(ProtoException.UNAUTHENTICATED, "refresh tokens cannot be used for API access");
            }
        }

        // Extract caller identity from token claims.
        // Supports both CredPair tokens (principal claim) and legacy tokens (service_name claim).
        String serviceName = tw.getPrincipal();
        if (serviceName.isEmpty()) {
            serviceName = tw.getServiceName();
        }
        if (serviceName == null || serviceName.isEmpty()) {
            throw new ProtoException(ProtoException.UNAUTHENTICATED, "token missing caller identity (principal or service_name claim)");
        }

        // Extract instance_id if present
        String instanceId = tw.getInstanceId();

        // Cache the result
        long exp = tw.getExpiration();
        CachedCaller result = new CachedCaller(serviceName, instanceId, exp);
        if (exp > 0) {
            // exp is an absolute epoch-second; the cache stores an absolute epoch-milli expiry.
            tokenCache.put(rawToken, result, exp * 1000L);
        }

        return result;
    }

    /**
     * Waits briefly for a just-published JWK to appear in shared kernel state.
     */
    private JwkOuterClass.Jwk waitForKeyByKid(Supplier<JwkOuterClass.Jwks> provider, String kid)
            throws ProtoException {
        // Fast path: key already present — no retry budget, no permit needed.
        JwkOuterClass.Jwk immediate = findKeyByKid(provider.get(), kid);
        if (immediate != null) {
            return immediate;
        }

        // H2(b)/#4: a recently-missed kid short-circuits without spending any retry budget.
        if (negativeKidCache.get(kid) != null) {
            return null;
        }

        // H1: bound the number of threads that may park in the retry loop. If no permit is
        // immediately available, fail fast (do NOT block) so the handler thread is freed; the
        // UNAUTHENTICATED status is retryable, so a legitimate client can try again shortly.
        if (!retrySlots.tryAcquire()) {
            logger.warn("[auth] unknown-kid retry slots exhausted — failing fast for kid (len={})",
                    kid.length());
            throw new ProtoException(ProtoException.UNAUTHENTICATED,
                    "authentication temporarily unavailable, retry");
        }
        try {
            // Re-check under the permit: the key may have arrived while we were acquiring.
            JwkOuterClass.Jwk jwk = findKeyByKid(provider.get(), kid);
            if (jwk != null) {
                return jwk;
            }

            long deadlineNanos = System.nanoTime() + UNKNOWN_KID_RETRY_TIMEOUT_MILLIS * 1_000_000L;
            long backoffMillis = UNKNOWN_KID_INITIAL_BACKOFF_MILLIS;

            while (true) {
                long remainingNanos = deadlineNanos - System.nanoTime();
                if (remainingNanos <= 0) {
                    // Remember the miss so subsequent probes short-circuit (#4 negative cache).
                    negativeKidCache.put(kid, Boolean.TRUE,
                            System.currentTimeMillis() + NEGATIVE_KID_CACHE_TTL_MILLIS);
                    return null;
                }

                long sleepMillis = Math.min(backoffMillis, Math.max(1, remainingNanos / 1_000_000L));
                try {
                    Thread.sleep(sleepMillis);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    return null;
                }
                backoffMillis = Math.min(backoffMillis * 2, UNKNOWN_KID_MAX_BACKOFF_MILLIS);

                jwk = findKeyByKid(provider.get(), kid);
                if (jwk != null) {
                    return jwk;
                }
            }
        } finally {
            retrySlots.release();
        }
    }

    private static JwkOuterClass.Jwk findKeyByKid(JwkOuterClass.Jwks keys, String kid) {
        if (keys == null) return null;
        for (JwkOuterClass.Jwk jwk : keys.getKeysList()) {
            if (kid.equals(jwk.getKid())) {
                return jwk;
            }
        }
        return null;
    }

    /**
     * Determines whether the given BackendPermsMode allows the specified operation.
     * <ul>
     *   <li>RO (1) = READ only</li>
     *   <li>RW (2) = READ + WRITE + ADMIN</li>
     *   <li>WORM (3) = READ + WRITE</li>
     * </ul>
     */
    static boolean isAllowed(int modeValue, OperationType op) {
        return switch (modeValue) {
            case 1 -> op == OperationType.READ; // RO
            case 2 -> true; // RW — everything
            case 3 -> op == OperationType.READ || op == OperationType.WRITE; // WORM
            default -> false; // UNSPECIFIED or unknown
        };
    }

    /** Cached result of token validation. */
    private static final class CachedCaller {
        final String serviceName;
        final String instanceId;
        final long expiresAt;

        CachedCaller(String serviceName, String instanceId, long expiresAt) {
            this.serviceName = serviceName;
            this.instanceId = instanceId;
            this.expiresAt = expiresAt;
        }
    }

    /**
     * Bounded, TTL-evicting cache. Access-order LRU with a hard size cap (oldest entry
     * evicted on overflow) plus a per-entry absolute expiry (epoch millis). Expired entries
     * are removed on access and opportunistically swept on insert, so neither a flood of
     * distinct keys nor stale entries can grow the map without bound. All access is
     * synchronized on the instance — adequate for the auth fast path, which is dominated by
     * signature verification rather than map contention.
     */
    private static final class BoundedTtlCache<K, V> {
        private final int maxEntries;
        private final LinkedHashMap<K, CacheEntry<V>> map;

        BoundedTtlCache(int maxEntries) {
            this.maxEntries = Math.max(1, maxEntries);
            this.map = new LinkedHashMap<>(16, 0.75f, true) {
                @Override
                protected boolean removeEldestEntry(Map.Entry<K, CacheEntry<V>> eldest) {
                    return size() > BoundedTtlCache.this.maxEntries;
                }
            };
        }

        synchronized V get(K key) {
            CacheEntry<V> e = map.get(key);
            if (e == null) {
                return null;
            }
            if (System.currentTimeMillis() >= e.expiresAtMillis) {
                map.remove(key);
                return null;
            }
            return e.value;
        }

        synchronized void put(K key, V value, long expiresAtMillis) {
            sweepExpired();
            map.put(key, new CacheEntry<>(value, expiresAtMillis));
        }

        /** Bounded sweep of expired entries so eviction is not purely lazy on re-presentation. */
        private void sweepExpired() {
            long now = System.currentTimeMillis();
            java.util.Iterator<Map.Entry<K, CacheEntry<V>>> it = map.entrySet().iterator();
            while (it.hasNext()) {
                if (now >= it.next().getValue().expiresAtMillis) {
                    it.remove();
                }
            }
        }

        private static final class CacheEntry<V> {
            final V value;
            final long expiresAtMillis;

            CacheEntry(V value, long expiresAtMillis) {
                this.value = value;
                this.expiresAtMillis = expiresAtMillis;
            }
        }
    }
}
