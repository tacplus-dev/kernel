/**
 * SecurityInterceptor validates JWT bearer tokens on every gRPC call and
 * enforces graph-level access policies.
 *
 * <p>Access policies are derived from proto annotations at build time.
 * No runtime security policy file is needed.
 *
 * <p>Token validation flow:
 * <ol>
 *   <li>Extract Bearer token from {@code authorization} header</li>
 *   <li>Parse JWT header to get {@code kid}</li>
 *   <li>Find matching key in verification keys</li>
 *   <li>Verify signature</li>
 *   <li>Validate claims: aud, sub non-empty, exp/iat/ttl</li>
 *   <li>Authorize: check graph access policies</li>
 *   <li>Store caller identity ({@code sub} claim) in gRPC Context</li>
 * </ol>
 *
 * <p>Generated by tacplus — do not edit.
 */
public class SecurityInterceptor implements ServerInterceptor {

    private static final Logger logger = LoggerFactory.getLogger(SecurityInterceptor.class);

    // --- Unknown-kid retry / DoS-hardening knobs (configurable via system properties) ---
    // The retry loop sleeps a gRPC handler thread waiting for a just-published JWK to
    // propagate into shared kernel state. Each of these guards a distinct DoS vector:
    //   * the timeout bounds how long a single thread is parked,
    //   * the semaphore bounds how many threads may be parked at once (pool exhaustion),
    //   * the kid format gate + negative cache short-circuit bogus kids before any sleep.
    private static final long UNKNOWN_KID_RETRY_TIMEOUT_MILLIS =
            Long.getLong("tacplus.auth.unknownKidRetryTimeoutMillis", 750L);
    private static final long UNKNOWN_KID_INITIAL_BACKOFF_MILLIS =
            Long.getLong("tacplus.auth.unknownKidInitialBackoffMillis", 25L);
    private static final long UNKNOWN_KID_MAX_BACKOFF_MILLIS =
            Long.getLong("tacplus.auth.unknownKidMaxBackoffMillis", 250L);

    /** Max number of handler threads that may concurrently sit in the unknown-kid retry loop. */
    private static final int UNKNOWN_KID_MAX_CONCURRENT_RETRIERS =
            Integer.getInteger("tacplus.auth.unknownKidMaxConcurrentRetriers", 8);

    /** Bounded positive token cache. */
    private static final int TOKEN_CACHE_MAX_ENTRIES =
            Integer.getInteger("tacplus.auth.tokenCacheMaxEntries", 10_000);

    /** Bounded negative cache for recently-missed kids. */
    private static final int NEGATIVE_KID_CACHE_MAX_ENTRIES =
            Integer.getInteger("tacplus.auth.negativeKidCacheMaxEntries", 1_024);
    private static final long NEGATIVE_KID_CACHE_TTL_MILLIS =
            Long.getLong("tacplus.auth.negativeKidCacheTtlMillis", 1_000L);

    /**
     * Plausible-kid gate. Production kids are base64url(24 bytes) = 32 chars of
     * {@code [A-Za-z0-9_-]} (see generateRandomID). We accept the permissive-but-safe
     * superset of base64url strings up to 128 chars so legacy / longer kids are not
     * rejected, while still cheaply rejecting obvious junk (control chars, oversized
     * blobs) before any retry budget is spent. Configurable via system property.
     */
    private static final int KID_MAX_LENGTH =
            Integer.getInteger("tacplus.auth.kidMaxLength", 128);
    private static final Pattern KID_FORMAT = Pattern.compile("^[A-Za-z0-9_-]{1,512}$");

    /** Context key for the authenticated caller's subject (sub claim). */
    public static final Context.Key<String> CALLER_SUBJECT_KEY = Context.key("caller-subject");

    /** Context key for the authenticated caller's instance ID (instance_id claim). */
    public static final Context.Key<String> CALLER_INSTANCE_ID_KEY = Context.key("caller-instance-id");

    /** Metadata key for the authorization header. */
    private static final Metadata.Key<String> AUTH_METADATA_KEY =
            Metadata.Key.of("authorization", Metadata.ASCII_STRING_MARSHALLER);

    /** Read operation prefixes — methods starting with these require RO or RW access. */
    private static final Set<String> READ_PREFIXES = Set.of(
            "Get", "Watch", "ContainsKey", "KeySet", "Size", "Query", "WatchQuery",
            "Poll", "Subscribe", "GetLeader", "WatchLeader");

    /** Write operation prefixes — methods starting with these require RW access. */
    private static final Set<String> WRITE_PREFIXES = Set.of(
            "Set", "Delete", "Offer", "Publish", "Execute", "Elect", "Resign", "RenewLease");

    private final Supplier<List<JwkOuterClass.Jwk>> keyProvider;
    private final String requiredAudience;
    private final long tokenTtlSeconds;

    /** Per-resource access policies keyed by resource name. Derived from proto annotations. */
    private static final Map<String, Policy> GRAPH_POLICIES;

    /** Graphs that skip authentication (backend_disable_auth annotation). */
    private static final Set<String> NO_AUTH_GRAPHS = {{NO_AUTH_GRAPHS_INIT}};

    /**
     * Service name → list of RPC method names.
     * Used by TokenExchangerService to populate the "entitlements" claim in S2S tokens,
     * and by this interceptor to validate entitlements on incoming requests.
     */
    public static final Map<String, List<String>> SERVICE_ENTITLEMENTS;

    static {
        Map<String, Policy> policies = new HashMap<>();
{{POLICY_MAP_INIT}}
        GRAPH_POLICIES = Map.copyOf(policies);

        Map<String, List<String>> m = new HashMap<>();
{{SERVICE_ENTITLEMENTS_INIT}}
        SERVICE_ENTITLEMENTS = Map.copyOf(m);
    }

    /**
     * Bounded cache of validated tokens: raw JWT string -> cached caller info.
     * Access-order LRU with a hard size cap; entries also carry a per-entry expiry
     * and are proactively evicted, so a flood of distinct (valid) tokens cannot grow
     * the map without bound. Guarded by its own monitor.
     */
    private final BoundedTtlCache<String, CachedCaller> tokenCache =
            new BoundedTtlCache<>(TOKEN_CACHE_MAX_ENTRIES);

    /**
     * Bounded negative cache of recently-missed kids. A bogus kid is recorded here so
     * repeated probes short-circuit instantly instead of each spending the retry budget.
     */
    private final BoundedTtlCache<String, Boolean> negativeKidCache =
            new BoundedTtlCache<>(NEGATIVE_KID_CACHE_MAX_ENTRIES);

    /** Bounds the number of handler threads concurrently parked in the unknown-kid retry loop. */
    private final Semaphore retrySlots = new Semaphore(Math.max(1, UNKNOWN_KID_MAX_CONCURRENT_RETRIERS));

    /**
     * @param requiredAudience expected "aud" claim in tokens
     * @param tokenTtlSeconds  maximum allowed token lifetime (0 = no limit)
     * @param keyProvider      supplies the current list of verification keys
     */
    public SecurityInterceptor(String requiredAudience, long tokenTtlSeconds,
                               Supplier<List<JwkOuterClass.Jwk>> keyProvider) {
        this.keyProvider = keyProvider;
        this.requiredAudience = requiredAudience;
        this.tokenTtlSeconds = tokenTtlSeconds;

        logger.info("SecurityInterceptor initialized: audience={}, ttl={}s, graphs={}",
                requiredAudience, tokenTtlSeconds, GRAPH_POLICIES.keySet());
    }

    @Override
    public <ReqT, RespT> ServerCall.Listener<ReqT> interceptCall(
            ServerCall<ReqT, RespT> call, Metadata headers, ServerCallHandler<ReqT, RespT> next) {

        String method = call.getMethodDescriptor().getFullMethodName();

        // Allow health checks and reflection without auth.
        if (method.startsWith("grpc.health.") || method.startsWith("grpc.reflection.")) {
            return next.startCall(call, headers);
        }

        // Allow no-auth graphs (backend_disable_auth annotation) without auth.
        // Check both backend state services and backend RPC services.
        if (isNoAuthMethod(method)) {
            return next.startCall(call, headers);
        }

        String authHeader = headers.get(AUTH_METADATA_KEY);
        if (authHeader == null) {
            logger.warn("[auth] {} — no authorization header", method);
            call.close(Status.UNAUTHENTICATED.withDescription("missing authorization header"), new Metadata());
            return new ServerCall.Listener<>() {};
        }

        if (!authHeader.startsWith("Bearer ")) {
            logger.warn("[auth] {} — authorization header not Bearer", method);
            call.close(Status.UNAUTHENTICATED.withDescription("authorization must be Bearer"), new Metadata());
            return new ServerCall.Listener<>() {};
        }

        String rawToken = authHeader.substring(7);
        CachedCaller caller;
        try {
            caller = resolveCallerFromToken(rawToken);
        } catch (Exception e) {
            logger.warn("[auth] {} — authentication failed: {}", method, e.getMessage());
            call.close(Status.UNAUTHENTICATED.withDescription(e.getMessage()), new Metadata());
            return new ServerCall.Listener<>() {};
        }

        logger.debug("[auth] {} — authenticated as {}", method, caller.subject);

        // Authorize: check graph access policies and entitlements
        String denial = authorizeCall(method, caller);
        if (denial != null) {
            logger.warn("[authz] {} — denied for {}: {}", method, caller.subject, denial);
            call.close(Status.PERMISSION_DENIED.withDescription(denial), new Metadata());
            return new ServerCall.Listener<>() {};
        }

        Context ctx = Context.current().withValue(CALLER_SUBJECT_KEY, caller.subject);
        if (caller.instanceId != null && !caller.instanceId.isEmpty()) {
            ctx = ctx.withValue(CALLER_INSTANCE_ID_KEY, caller.instanceId);
        }
        return Contexts.interceptCall(ctx, call, headers, next);
    }

    /**
     * Checks if a method belongs to a no-auth graph (backend_disable_auth).
     * Matches:
     *   - State backend services: {Name}BackendService (e.g., TokenExchangerStateBackendService)
     *   - Associated RPC services: {NameWithoutState}Service (e.g., TokenExchangerService)
     *     This handles the convention where TokenExchangerState has a companion
     *     TokenExchangerService (service_backend_rpc = "TokenExchanger").
     */
    private static boolean isNoAuthMethod(String method) {
        if (NO_AUTH_GRAPHS.isEmpty()) return false;
        int slashIdx = method.indexOf('/');
        if (slashIdx < 0) return false;
        String serviceName = method.substring(0, slashIdx);
        int dotIdx = serviceName.lastIndexOf('.');
        String simpleName = serviceName.substring(dotIdx + 1);
        for (String graph : NO_AUTH_GRAPHS) {
            // Match state service: TokenExchangerState → TokenExchangerStateStateService
            if (simpleName.equals(graph + "StateService")) {
                return true;
            }
            // Match associated RPC service: TokenExchangerState → TokenExchangerService
            // Strip "State" suffix from graph name to derive the RPC service name.
            if (graph.endsWith("State")) {
                String base = graph.substring(0, graph.length() - "State".length());
                if (simpleName.equals(base + "Service")) {
                    return true;
                }
            }
        }
        return false;
    }

    private String authorizeCall(String method, CachedCaller caller) {
        int slashIdx = method.indexOf('/');
        if (slashIdx < 0) {
            return null;
        }

        String serviceName = method.substring(0, slashIdx);
        String operation = method.substring(slashIdx + 1);

        if (!serviceName.endsWith("StateService")) {
            return null;
        }

        int dotIdx = serviceName.lastIndexOf('.');
        String graphName = serviceName.substring(dotIdx + 1,
                serviceName.length() - "StateService".length());

        Policy policy = GRAPH_POLICIES.get(graphName);
        if (policy == null) {
            return "no access policy for graph " + graphName;
        }

        boolean isWrite = false;
        boolean isRead = false;
        for (String prefix : WRITE_PREFIXES) {
            if (operation.startsWith(prefix)) {
                isWrite = true;
                break;
            }
        }
        if (!isWrite) {
            for (String prefix : READ_PREFIXES) {
                if (operation.startsWith(prefix)) {
                    isRead = true;
                    break;
                }
            }
        }

        if (!isWrite && !isRead) {
            return null;
        }

        String subject = caller.subject;
        if (isWrite) {
            if (!matchesAny(policy.rw, subject)) {
                return subject + " does not have write access to " + graphName;
            }
        } else {
            if (!matchesAny(policy.rw, subject) && !matchesAny(policy.ro, subject)) {
                return subject + " does not have read access to " + graphName;
            }
        }

        // Check entitlements claim (if present).
        // During rollout, absent entitlements are allowed — graph ACLs still protect.
        // Once all services exchange with entitlements, tighten to require the claim.
        if (caller.entitlements != null && !caller.entitlements.contains("*")) {
            if (!caller.entitlements.contains(operation)) {
                return subject + " lacks entitlement for " + operation + " on " + graphName;
            }
        }

        return null;
    }

    private static boolean matchesAny(List<String> patterns, String subject) {
        for (String pattern : patterns) {
            if (matchesPattern(pattern, subject)) {
                return true;
            }
        }
        return false;
    }

    private static boolean matchesPattern(String pattern, String subject) {
        if (pattern.equals(subject) || "*".equals(pattern)) {
            return true;
        }
        int pColon = pattern.indexOf(':');
        if (pColon < 0) {
            return false;
        }
        int sColon = subject.indexOf(':');
        if (sColon < 0) {
            return false;
        }
        String pType = pattern.substring(0, pColon);
        String pName = pattern.substring(pColon + 1);
        String sType = subject.substring(0, sColon);
        String sName = subject.substring(sColon + 1);
        return ("*".equals(pType) || pType.equals(sType))
                && ("*".equals(pName) || pName.equals(sName));
    }

    private CachedCaller resolveCallerFromToken(String rawToken) {
        CachedCaller cached = tokenCache.get(rawToken);
        if (cached != null) {
            return cached;
        }

        TokenWrapper tw = TokenWrapper.parse(rawToken);

        String kid = tw.getKid();
        if (kid == null || kid.isEmpty()) {
            throw new SecurityException("token missing kid header");
        }

        // H2 gate (a): reject implausible kids before spending any retry budget.
        if (kid.length() > KID_MAX_LENGTH || !KID_FORMAT.matcher(kid).matches()) {
            throw new SecurityException("malformed kid");
        }

        JwkOuterClass.Jwk matchingKey = waitForKeyByKid(kid);
        if (matchingKey == null) {
            throw new SecurityException("unknown kid: " + kid);
        }

        ImmutableJwk immJwk = ImmutableJwk.from(matchingKey);
        tw.verify(immJwk);

        validateClaims(tw);

        String subject = tw.getSubject();
        String instanceId = tw.getInstanceId();
        List<String> entitlements = extractEntitlements(tw);

        long exp = tw.getExpiration();
        CachedCaller result = new CachedCaller(subject, instanceId, exp, entitlements);
        if (exp > 0) {
            // exp is an absolute epoch-second; the cache stores an absolute epoch-milli expiry.
            tokenCache.put(rawToken, result, exp * 1000L);
        }

        return result;
    }

    private void validateClaims(TokenWrapper tw) {
        String aud = tw.getAudience();
        if (!requiredAudience.equals(aud)) {
            throw new SecurityException("invalid audience: expected '" + requiredAudience + "', got '" + aud + "'");
        }

        String sub = tw.getSubject();
        if (sub.isEmpty()) {
            throw new SecurityException("token missing subject (sub) claim");
        }

        long now = Instant.now().getEpochSecond();

        long exp = tw.getExpiration();
        if (exp <= now) {
            throw new SecurityException("token has expired");
        }

        long iat = tw.getIssuedAt();
        if (iat > 0 && iat > now + 60) {
            throw new SecurityException("token issued in the future");
        }

        if (tokenTtlSeconds > 0 && iat > 0 && (exp - iat) > tokenTtlSeconds) {
            throw new SecurityException("token lifetime " + (exp - iat) + "s exceeds max " + tokenTtlSeconds + "s");
        }
    }

    private JwkOuterClass.Jwk waitForKeyByKid(String kid) {
        // Fast path: key already present — no retry budget, no permit needed.
        JwkOuterClass.Jwk immediate = findKeyByKid(keyProvider.get(), kid);
        if (immediate != null) {
            return immediate;
        }

        // H2(b)/#4: a recently-missed kid short-circuits without spending any retry budget.
        if (negativeKidCache.get(kid) != null) {
            return null;
        }

        // H1: bound the number of threads that may park in the retry loop. If no permit is
        // immediately available, fail fast (do NOT block) so the handler thread is freed; the
        // UNAUTHENTICATED status is retryable, so a legitimate client can try again shortly.
        if (!retrySlots.tryAcquire()) {
            logger.warn("[auth] unknown-kid retry slots exhausted — failing fast for kid (len={})",
                    kid.length());
            throw new SecurityException("authentication temporarily unavailable, retry");
        }
        try {
            // Re-check under the permit: the key may have arrived while we were acquiring.
            JwkOuterClass.Jwk jwk = findKeyByKid(keyProvider.get(), kid);
            if (jwk != null) {
                return jwk;
            }

            long deadlineNanos = System.nanoTime() + UNKNOWN_KID_RETRY_TIMEOUT_MILLIS * 1_000_000L;
            long backoffMillis = UNKNOWN_KID_INITIAL_BACKOFF_MILLIS;

            while (true) {
                long remainingNanos = deadlineNanos - System.nanoTime();
                if (remainingNanos <= 0) {
                    // Remember the miss so subsequent probes short-circuit (#4 negative cache).
                    negativeKidCache.put(kid, Boolean.TRUE,
                            System.currentTimeMillis() + NEGATIVE_KID_CACHE_TTL_MILLIS);
                    return null;
                }

                long sleepMillis = Math.min(backoffMillis, Math.max(1, remainingNanos / 1_000_000L));
                try {
                    Thread.sleep(sleepMillis);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    return null;
                }
                backoffMillis = Math.min(backoffMillis * 2, UNKNOWN_KID_MAX_BACKOFF_MILLIS);

                jwk = findKeyByKid(keyProvider.get(), kid);
                if (jwk != null) {
                    return jwk;
                }
            }
        } finally {
            retrySlots.release();
        }
    }

    private static JwkOuterClass.Jwk findKeyByKid(List<JwkOuterClass.Jwk> keys, String kid) {
        if (keys == null) {
            return null;
        }
        for (JwkOuterClass.Jwk jwk : keys) {
            if (kid.equals(jwk.getKid())) {
                return jwk;
            }
        }
        return null;
    }

    /**
     * Extracts the "entitlements" claim from a parsed token as a list of strings.
     * Returns null if the claim is absent.
     */
    private static List<String> extractEntitlements(TokenWrapper tw) {
        List<String> entitlements = tw.getEntitlements();
        return entitlements.isEmpty() ? null : entitlements;
    }

    /** Helper to build a policy from lists. Used by the static initializer. */
    private static Policy buildPolicy(String name, List<String> rw, List<String> ro, List<String> exec) {
        return new Policy(rw, ro);
    }

    private static final class Policy {
        final List<String> rw;
        final List<String> ro;

        Policy(List<String> rw, List<String> ro) {
            this.rw = rw;
            this.ro = ro;
        }
    }

    private static final class CachedCaller {
        final String subject;
        final String instanceId;
        final long expiresAt;
        final List<String> entitlements;

        CachedCaller(String subject, String instanceId, long expiresAt, List<String> entitlements) {
            this.subject = subject;
            this.instanceId = instanceId;
            this.expiresAt = expiresAt;
            this.entitlements = entitlements;
        }
    }

    /**
     * Bounded, TTL-evicting cache. Access-order LRU with a hard size cap (oldest entry
     * evicted on overflow) plus a per-entry absolute expiry (epoch millis). Expired entries
     * are removed on access and opportunistically swept on insert, so neither a flood of
     * distinct keys nor stale entries can grow the map without bound. All access is
     * synchronized on the instance — adequate for the auth fast path, which is dominated by
     * signature verification rather than map contention.
     */
    private static final class BoundedTtlCache<K, V> {
        private final int maxEntries;
        private final LinkedHashMap<K, CacheEntry<V>> map;

        BoundedTtlCache(int maxEntries) {
            this.maxEntries = Math.max(1, maxEntries);
            this.map = new LinkedHashMap<>(16, 0.75f, true) {
                @Override
                protected boolean removeEldestEntry(Map.Entry<K, CacheEntry<V>> eldest) {
                    return size() > BoundedTtlCache.this.maxEntries;
                }
            };
        }

        synchronized V get(K key) {
            CacheEntry<V> e = map.get(key);
            if (e == null) {
                return null;
            }
            if (System.currentTimeMillis() >= e.expiresAtMillis) {
                map.remove(key);
                return null;
            }
            return e.value;
        }

        synchronized void put(K key, V value, long expiresAtMillis) {
            sweepExpired();
            map.put(key, new CacheEntry<>(value, expiresAtMillis));
        }

        /** Bounded sweep of expired entries so eviction is not purely lazy on re-presentation. */
        private void sweepExpired() {
            long now = System.currentTimeMillis();
            java.util.Iterator<Map.Entry<K, CacheEntry<V>>> it = map.entrySet().iterator();
            while (it.hasNext()) {
                if (now >= it.next().getValue().expiresAtMillis) {
                    it.remove();
                }
            }
        }

        private static final class CacheEntry<V> {
            final V value;
            final long expiresAtMillis;

            CacheEntry(V value, long expiresAtMillis) {
                this.value = value;
                this.expiresAtMillis = expiresAtMillis;
            }
        }
    }
}
