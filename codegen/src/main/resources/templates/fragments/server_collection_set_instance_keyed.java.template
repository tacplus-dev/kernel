
    @Override
    public void set{{FIELD_PASCAL}}({{QUALIFIED_TYPE}} request,
            StreamObserver<{{OUTER_CLASS}}.MapEmpty> responseObserver) {
        try {
            checkAccess("{{FIELD_NAME}}", SecurityAuthenticator.OperationType.WRITE);

            // Extract instance identity from auth context
            String subject = SecurityAuthenticator.CALLER_SERVICE_KEY.get();
            String instanceId = SecurityAuthenticator.CALLER_INSTANCE_ID_KEY.get();
            if (instanceId == null || instanceId.isEmpty()) {
                responseObserver.onError(Status.FAILED_PRECONDITION
                    .withDescription("token missing instance_id claim — token predates instance_id support")
                    .asRuntimeException());
                return;
            }

            // Extract short service name from SPIFFE URI for service_id.
            // subject is a SPIFFE URI like "spiffe://local/dev/eventbus" — the
            // service name is the first path segment after the spiffe_prefix.
            // Consumers match against service_id using the short name.
            String serviceId = subject;
            if (subject.startsWith("spiffe://")) {
                String path = subject.substring("spiffe://".length());
                int lastSlash = path.lastIndexOf('/');
                if (lastSlash >= 0) {
                    serviceId = path.substring(lastSlash + 1);
                }
            }

            // Server-authoritative: build composite key and overwrite identity fields
            String compositeKey = serviceId + "@" + instanceId;
            {{QUALIFIED_TYPE}} authoritative = request.toBuilder()
                .setId(compositeKey)
                .setServiceId(serviceId)
                .setInstanceId(instanceId)
                .build();

            {{HELPERS_REF}}.validate{{TYPE_NAME}}(authoritative);
            {{TTL_SET_CALL}}
            responseObserver.onNext({{OUTER_CLASS}}.MapEmpty.getDefaultInstance());
            responseObserver.onCompleted();
        } catch (ProtoException e) {
            responseObserver.onError(toGrpcError(e));
        } catch (Exception e) {
            responseObserver.onError(Status.INTERNAL
                .withDescription("failed to set {{FIELD_PASCAL}}: " + e.getMessage())
                .withCause(e).asRuntimeException());
        }
    }
