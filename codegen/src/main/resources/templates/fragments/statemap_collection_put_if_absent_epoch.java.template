    /**
     * Stores {@code value} under {@code id} only if the id is absent, atomically at the
     * id's partition owner, with the same TTL put gives it. Returns the value bound to
     * {@code id} afterwards: the existing value if one was already there (nothing is
     * written), otherwise {@code value}.
     */
    public {{QUALIFIED_TYPE}} putIfAbsent{{FIELD_PASCAL}}(String id, {{QUALIFIED_TYPE}} value) throws ProtoException {
        {{HELPERS_REF}}.validate{{TYPE_NAME}}(value);
        long epochExp = value.{{EPOCH_GETTER}}();
        {{QUALIFIED_TYPE}} existing;
        if (epochExp > 0) {
            long ttl = epochExp - (System.currentTimeMillis() / 1000);
            existing = {{FIELD_CAMEL}}Map.putIfAbsent(id, value, ttl, java.util.concurrent.TimeUnit.SECONDS);
        } else {
            existing = {{FIELD_CAMEL}}Map.putIfAbsent(id, value);
        }
        return existing != null ? existing : value;
    }
