            existing = {{FIELD_CAMEL}}Map.putIfAbsent(key, value, ttl, java.util.concurrent.TimeUnit.SECONDS);
        } else {
            existing = {{FIELD_CAMEL}}Map.putIfAbsent(key, value);
        }
        return existing != null ? existing : value;
