<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.gitlab.secondstarcavalier.controlplane.services.kernel</groupId>
	<artifactId>kernel-parent</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>Kernel Parent</name>
	<description>Parent POM for kernel</description>
	<modules>
		<module>generator</module>
		<module>server</module>
	</modules>
	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Dependency versions -->
		<protobuf.version>4.34.0</protobuf.version>
		<grpc.version>1.79.0</grpc.version>
		<snakeyaml.version>2.5</snakeyaml.version>
		<toml4j.version>0.7.2</toml4j.version>
		<gson.version>2.13.2</gson.version>
		<jjwt.version>0.13.0</jjwt.version>
		<junit.version>6.0.2</junit.version>
		<maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
		<hazelcast.version>5.5.0</hazelcast.version>
		<spotless-maven-plugin.version>3.2.1</spotless-maven-plugin.version>
		<shade-plugin.version>3.6.1</shade-plugin.version>
		<exec-plugin.version>3.5.0</exec-plugin.version>
	</properties>
	<repositories>
		<repository>
			<id>gitlab-maven</id>
			<url>https://gitlab.com/api/v4/projects/79641700/packages/maven</url>
		</repository>
	</repositories>
	<distributionManagement>
		<repository>
			<id>gitlab-maven</id>
			<url>${env.CI_API_V4_URL}/projects/${env.CI_PROJECT_ID}/packages/maven</url>
		</repository>
	</distributionManagement>
</project>
