{
  "$defs": {
    "BoundaryInfo": {
      "description": "Describes a state boundary",
      "properties": {
        "boundary": {
          "type": "string"
        },
        "boundary_callers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "boundary_perms": {
          "items": {
            "$ref": "#/$defs/StatePermEntry"
          },
          "type": "array"
        },
        "collection": {
          "type": "boolean"
        },
        "consistency": {
          "type": "string"
        },
        "internal": {
          "type": "boolean"
        },
        "persistence": {
          "type": "boolean"
        },
        "state_perms": {
          "items": {
            "$ref": "#/$defs/StatePermEntry"
          },
          "type": "array"
        },
        "state_root": {
          "type": "string"
        },
        "type_fqn": {
          "type": "string"
        },
        "uncached": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "EnumValueInfo": {
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "FieldInfo": {
      "description": "Describes a field within a message type",
      "properties": {
        "constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default_json": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enum_values": {
          "items": {
            "$ref": "#/$defs/EnumValueInfo"
          },
          "type": "array"
        },
        "graph_index": {
          "description": "Graph index directives from (spec.graph_index)",
          "type": "string"
        },
        "map_key_type": {
          "type": "string"
        },
        "map_value_type": {
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/TypeInfo"
        },
        "name": {
          "type": "string"
        },
        "repeated": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "description": "TypeKind enum value",
          "type": "string"
        }
      },
      "type": "object"
    },
    "PackageNode": {
      "description": "A node in the hierarchical registry tree",
      "properties": {
        "boundaries": {
          "items": {
            "$ref": "#/$defs/BoundaryInfo"
          },
          "type": "array"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/PackageNode"
          },
          "type": "array"
        },
        "docs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "full_path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rpcs": {
          "items": {
            "$ref": "#/$defs/RpcInfo"
          },
          "type": "array"
        },
        "schema": {
          "type": "string"
        },
        "subscriptions": {
          "items": {
            "$ref": "#/$defs/SubscriptionInfo"
          },
          "type": "array"
        },
        "types": {
          "items": {
            "$ref": "#/$defs/TypeInfo"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RpcInfo": {
      "description": "Describes a gRPC RPC method",
      "properties": {
        "auth_any_user": {
          "type": "boolean"
        },
        "auth_disabled": {
          "type": "boolean"
        },
        "auth_entitled_users": {
          "type": "boolean"
        },
        "auth_services": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "category": {
          "enum": [
            "RPC_CATEGORY_ACCESSOR",
            "RPC_CATEGORY_MUTATOR",
            "RPC_CATEGORY_EXECUTOR"
          ],
          "type": "string"
        },
        "client_streaming": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "grpc_path": {
          "description": "Full gRPC method path",
          "type": "string"
        },
        "http_methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "http_path": {
          "description": "REST path for gateway routing",
          "type": "string"
        },
        "input_type": {
          "type": "string"
        },
        "output_type": {
          "type": "string"
        },
        "rpc": {
          "type": "string"
        },
        "server_streaming": {
          "type": "boolean"
        },
        "service_name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "StatePermEntry": {
      "description": "State-to-state access grant",
      "properties": {
        "mode": {
          "enum": [
            "STATE_PERMS_MODE_RO",
            "STATE_PERMS_MODE_RW",
            "STATE_PERMS_MODE_WORM",
            "STATE_PERMS_MODE_CALL"
          ],
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "SubscriptionInfo": {
      "description": "Event-bus topic subscription declared via (spec.subscribe)",
      "properties": {
        "source": {
          "description": "Original annotation value, e.g. aegis.AegisState.event_stream",
          "type": "string"
        },
        "source_field": {
          "description": "Topic field name on the source state root",
          "type": "string"
        },
        "source_package": {
          "description": "Proto package of the source state root",
          "type": "string"
        },
        "source_state_root": {
          "description": "Source state root message name",
          "type": "string"
        },
        "source_type_fqn": {
          "description": "Fully qualified proto type of the topic message",
          "type": "string"
        }
      },
      "type": "object"
    },
    "TypeInfo": {
      "description": "Describes a protobuf message type",
      "properties": {
        "bigdata_key": {
          "description": "Primary key field name from (spec.bigdata).key",
          "type": "string"
        },
        "bigdata_name": {
          "description": "BigData type name from (spec.bigdata).name",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldInfo"
          },
          "type": "array"
        },
        "fqn": {
          "description": "Fully qualified name",
          "type": "string"
        },
        "graph_type": {
          "description": "Graph type name from (spec.graph_type)",
          "type": "string"
        },
        "graph_xid_field": {
          "description": "Field used for upsert xid from (spec.graph_type).xid_field",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "schema_json": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for the tacplus registry.json — a self-describing hierarchical registry of types, RPCs, boundaries, and security metadata.",
  "properties": {
    "$schema": {
      "description": "JSON Schema reference",
      "type": "string"
    },
    "boundaries": {
      "description": "State boundary descriptors",
      "items": {
        "$ref": "#/$defs/BoundaryInfo"
      },
      "type": "array"
    },
    "children": {
      "description": "Sub-packages contained in this node",
      "items": {
        "$ref": "#/$defs/PackageNode"
      },
      "type": "array"
    },
    "docs": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Documentation files (filename → content). Present on root node only.",
      "type": "object"
    },
    "full_path": {
      "description": "Slash-separated path from root",
      "type": "string"
    },
    "name": {
      "description": "Short package name",
      "type": "string"
    },
    "rpcs": {
      "description": "RPC descriptors",
      "items": {
        "$ref": "#/$defs/RpcInfo"
      },
      "type": "array"
    },
    "schema": {
      "description": "Self-description pointer",
      "type": "string"
    },
    "subscriptions": {
      "description": "Event-bus topic subscriptions declared on state roots",
      "items": {
        "$ref": "#/$defs/SubscriptionInfo"
      },
      "type": "array"
    },
    "types": {
      "description": "Message type descriptors",
      "items": {
        "$ref": "#/$defs/TypeInfo"
      },
      "type": "array"
    }
  },
  "title": "tacplus Registry",
  "type": "object"
}