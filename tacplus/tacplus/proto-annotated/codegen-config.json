  "interfacesPackage": "com.gitlab.secondstarcavalier.controlplane.services.proto.interfaces.java.graphs",
  "securityPolicies": [
    {
      "name": "ClickHouseState",
      "package": "clickhouse",
      "rw": [
        "service:clickhouse"
      ],
      "ro": [
        "*"
      ]
    },
    {
      "name": "ClickhouseConfigState",
      "package": "clickhouse",
      "rw": [
