  "serviceRPCMappings": [
    {
      "serviceName": "sentinel",
      "rpcs": [
        "GetClusterInfo",
        "GetClusterHealth",
        "GetNodeMetrics",
        "GetGrpcStats",
        "GetPersistenceStatus",
        "GetNetworkStats",
        "GetThreadInfo",
        "GetTokenCacheStats",
        "GetMapStats",
        "GetDashboard",
        "WatchDashboard"
      ]
    },
