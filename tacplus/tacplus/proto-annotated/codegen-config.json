      ],
      "ro": [
        "*"
      ]
    },
    {
      "name": "Identity",
      "package": "kernel",
      "rw": [
        "service:kernel"
      ],
      "ro": [
        "*"
      ],
      "disableAuth": true
    },
    {
      "name": "TrustedCa",
